// Default: https://github.com/zellij-org/zellij/blob/main/example/default.kdl
show_startup_tips false
advanced_mouse_actions false
mouse_hover_effects false
default_shell "zsh"
// Required for zjstatus
pane_frames false
keybinds {
    // Update `move` and `session` to Ctrl+8 and Ctrl+9
    unbind "Ctrl h" "Ctrl o"
    shared_except "locked" "move" {
        bind "Ctrl 8" {
            SwitchToMode "move"
        }
    }
    shared_except "locked" "session" {
        bind "Ctrl 9" {
            SwitchToMode "session"
        }
    }
    move {
        bind "Ctrl 8" {
            SwitchToMode "normal"
        }
    }
    session {
        bind "Ctrl 9" {
            SwitchToMode "normal"
        }
    }
}

